# Copy this file to .env and fill in your API keys
# NEVER commit .env to git

# LLM Provider — Anthropic (primary), OpenAI (optional secondary)
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Default model
# Development: claude-haiku-4-5-20251001 (fast, cheap ~$0.001/txn)
# Production/demo: claude-sonnet-4-6 (richer reasoning ~$0.01/txn)
DEFAULT_MODEL=claude-haiku-4-5-20251001
