# Copy this file to .env. With no API key set, the agent runs in deterministic mock mode (no cost).
# For real LLM mode, uncomment one key and fill it in. NEVER commit .env to git.

# LLM Provider — Anthropic (primary), OpenAI (optional secondary)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Default model: "claude" in the name routes to ChatAnthropic, otherwise ChatOpenAI.
# If you use an OpenAI key, set DEFAULT_MODEL to an OpenAI model name as well.
# Development: claude-haiku-4-5-20251001 (fast, cheap; measured about $0.004 per transaction)
# Production/demo: claude-sonnet-4-6 (richer reasoning)
DEFAULT_MODEL=claude-haiku-4-5-20251001
