# Copy this file to .env. With no API key set, the agents run in deterministic mock mode (no cost).
# For real LLM mode, uncomment one key and fill it in. NEVER commit .env to git.

# LLM Provider — Anthropic (primary), OpenAI (optional secondary)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Default model: "claude" in the name routes to ChatAnthropic, otherwise ChatOpenAI.
# If you use an OpenAI key, set DEFAULT_MODEL to an OpenAI model name as well.
# Claude models are called with effort=low and max_tokens=8192 and no temperature, because
# Claude Haiku 5.5 rejects one (src/llm.py). OpenAI models are still called at temperature 0.
# Development: claude-haiku-5-5 (fast, cheap; the default since 2026-10-13)
# Production/demo: claude-sonnet-5-5 (richer reasoning for debate)
DEFAULT_MODEL=claude-haiku-5-5
